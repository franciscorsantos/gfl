# Chave secreta para sessões e segurança do Flask
# Gere uma chave segura, por exemplo, com: python -c 'import secrets; print(secrets.token_hex())'
SECRET_KEY='sua-chave-secreta-super-segura-aqui'

# URL de conexão com o banco de dados
# Para desenvolvimento com SQLite (padrão):
DATABASE_URL='sqlite:///instance/gfl.db'

# Para produção com PostgreSQL (exemplo):
# DATABASE_URL='postgresql://usuario:senha@host:porta/nome_do_banco'

# Credenciais do usuário Administrador padrão criado pelo seed_db.py
ADMIN_EMAIL='admin@gfl.com'
ADMIN_PASSWORD='admin123'